<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. M1 reaches the desktop daemon through `adb reverse tcp:18481 tcp:18481`, so the app talks
  ws:// to the phone's own loopback. Cleartext is allowed for 127.0.0.1 and nothing else.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
