# The dial's config. ESP-IDF reads this first, then appends sdkconfig.defaults.esp32s3.
#
# CONFIG_IDF_TARGET IS HERE, AND THAT MATTERS. IDF only reads sdkconfig.defaults.<target> once it
# already knows the target, so while it lived in the per-target file a build that named no target
# guessed — from a stale `sdkconfig` if one was lying around, and from plain `esp32` if not, which
# died at CMake on a clean checkout (verified 2026-09-28). With one board there is nothing to choose
# between, so the choice is made here, once, where it is always read.
CONFIG_IDF_TARGET="esp32s3"

# --- Flash (both boards carry 16 MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- OTA (over-the-air firmware update) ---
# Dual-OTA partitions (see partitions.csv) + rollback: a freshly-flashed OTA image boots in
# PENDING_VERIFY and must call esp_ota_mark_app_valid_cancel_rollback() once healthy, else the
# bootloader reverts to the previous slot on the next reboot (a bad update can't brick the device).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Allow OTA over plain HTTP (no TLS). Security here is version-gate + SHA-256 integrity check
# (see main/ota.c); image signing / HTTPS is a deferred follow-up. Without this, esp_https_ota_begin
# refuses a non-verified server ("No option for server verification is enabled").
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- Main task stack (init only) ---
# The main task runs app_main, which starts the other tasks and ends in vTaskDelete(NULL): it is gone for the
# rest of the run, so this size is paid at boot only. The OTA download that once ran here (and needed 10 KiB) is
# gone. Measured peak use 2,092 B (SLP profile build, 2026-10-28: 8,148 of 10,240 B free at app_ready and at the end of
# app_main). 4096 = max(3072, 2092 + 1536) rounded up to 512. Paths the profile did not run: the factory reset
# (config_clear_all, a BOOT press at power-on) and the NVS erase on a bad partition; both are a few NVS calls.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- Log level ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y


CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Panic output must reach the wire. The PRIMARY console is where the panic handler, the stack-overflow
# canary and the task watchdog print — and it used to be UART0, whose pins this round board does not bring
# out anywhere. So a crash was completely invisible: the device rebooted, the USB port re-enumerated under
# a new name, and the only symptom was a byte counter that stopped moving. Debugging that is guesswork.
#
# With USB-Serial-JTAG as the PRIMARY console, a panic goes out the same wire the protocol uses, arrives as
# a non-JSON line, and CableLink.onRawLine already records those to cable.log. Secondary is NONE because a
# console cannot be its own mirror.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── a wedged UI task reboots instead of freezing ─────────────────────────────────────────────────────
# The render task subscribes to the task watchdog (display_habitat.c). Without PANIC the watchdog only prints a
# warning every few seconds and the glass stays frozen; with it the dial reboots, and the reset reason
# plus the last log lines before it come back over the cable (last_words.c). 10s rather than the 5s
# default: a full-face redraw or a touch-controller reset (60ms of delays inside the indev read) must
# never be mistaken for a hang.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
