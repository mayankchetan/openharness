# The round dial (ESP32-S3-Touch-AMOLED-1.75C), everything specific to the silicon.
#
# CONFIG_IDF_TARGET moved to sdkconfig.defaults when the Pro left — see the note there. This file is
# kept rather than folded in because IDF's per-target mechanism is what applies it, and a value that
# names a pin count, a PSRAM mode or a CPU clock belongs on that side of the line.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM (ESP32-S3R8 = 8MB octal PSRAM; LVGL object pool lives here) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# Allocations up to this size try internal RAM first; bigger ones go to PSRAM. 1,024 B is the value the bench
# images ran with (bench6); 16,384 B kept mid-size blocks in the 150 KB internal heap. Queues, task control
# blocks and stacks of the tasks still created with xTaskCreate stay internal whatever this says.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- WiFi (STA for commander, AP for provisioning portal) ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Buffer counts, explicit. While SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y (above) and PSRAM is found, the IDF defaults
# are 16 static RX and a 16-frame block-ack window, and the static TX count stays at 16: 14 more 1.6 KB
# buffers than the bench images used (10 RX, 8 TX); in the bench the main internal region had 0 B free after
# the Wi-Fi start. 6/6 with a 12-frame window is the memory-saving profile Espressif's Wi-Fi guide lists (the
# compile-time checks in esp_wifi/src/wifi_init.c need BA_WIN <= 2 x STATIC_RX and <= DYNAMIC_RX = 32).
# Voice is 8 KB/s of ADPCM, so throughput is not the limit; the bench gate (round-trip p95, bulk kbit/s)
# decides if 6 is too low, in which case go back towards the bench values 10/8.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=12
# Wi-Fi hot paths run from flash/PSRAM, not from IRAM-placed internal RAM. Measured on the dial at the production
# buffer counts above (W2 with the options on, W2n with them off): 18,176 B more internal RAM free at run time, bulk
# throughput 1,295 to 1,239 kbit/s (-4.5 percent), no lost acks, voice-rate round trip p95 219 to 200 ms. Voice needs
# about 64 kbit/s. IDF default is on (y).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# PHY calibration data is kept in NVS (the "phy" namespace): the first esp_wifi_start of a boot reads it and, if it is missing or stale, writes a fresh
# one. That is why the Wi-Fi bring-up runs on an internal-stack task (net_link.c, wifi_sta.h) and the PSRAM-stack net_link task never does. This is the
# IDF default, written down because the stack rule depends on it.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y

# --- HTTP server (captive portal) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# --- WebSocket client ---
CONFIG_WS_TRANSPORT=y

# --- TLS (wss:// + https:// to the prod backend) ---
# Verify the prod cert chain against Mozilla's CA roots via esp_crt_bundle_attach.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Leave CONFIG_MBEDTLS_HAVE_TIME_DATE OFF (default) so the TLS handshake does NOT depend on a synced
# clock — REST pairing runs before SNTP, and cert validity dates are not enforced.
# Allocate mbedTLS buffers (~32KB per TLS conn: two 16KB record buffers) from the 8MB PSRAM instead
# of the ~150KB internal heap. Internal heap fragments after the first few TLS connections, so the
# persistent commander WSS + periodic REST fail ssl_setup with -0x7F00 (ALLOC_FAILED) / sock<0.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Record buffers as measured on the dial with TLS up (bench6 and W0): 16,384 B in, 4,096 B out, both in PSRAM through the switch above. These
# are the IDF defaults; they are written down so a changed default cannot silently put 32 KB of record buffers back (MBEDTLS_DYNAMIC_BUFFER stays off).
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# TLS-PSK link to the daemon (cable_xport_tls.c, task B2): the client side of TLS-ECDHE-PSK, TLS 1.2. This is the whole key-exchange set
# the wrapper needs; plain PSK (no forward secrecy), DHE-PSK and RSA-PSK stay off, and cable_xport_tls.c offers only the two ECDHE-PSK
# CBC suites in any case. TLS 1.3 (CONFIG_MBEDTLS_SSL_PROTO_TLS1_3) stays at its default, off. esp-tls is not used for this link:
# its PSK switch (CONFIG_ESP_TLS_PSK_VERIFICATION) would also select RSA-PSK, and its BIO is bound to a socket.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
# No client session tickets: a resumed session would skip the PSK exchange, and nothing here needs resumption (TLS 1.3 and the esp-tls
# ticket switch are off). cable_xport_tls.c also disables tickets in code when they are compiled in.
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n

# --- LWIP: room for commander WS + HTTP client + DNS concurrently ---
CONFIG_LWIP_MAX_SOCKETS=16
# The LAN is IPv4 only; the IPv6 stack costs about 2 KB at boot and 7 KB while running (Espressif docs figure,
# not measured on this build).
CONFIG_LWIP_IPV6=n
# TCP send/receive buffers: 11,520 B, twice the 5,760 B IDF default. Voice over the wireless path is IMA ADPCM
# at 64 kbit/s = 8 KB/s, so 11,520 B holds about 1.4 s of it; the bench voice-rate stream saw a worst round
# trip of 452-497 ms. (This was 65,534 B for PCM voice over TCP at 32 KB/s; that path is gone. OTA and pet
# packs travel over the USB cable today.)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
