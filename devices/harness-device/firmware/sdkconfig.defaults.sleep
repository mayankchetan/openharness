# Battery light sleep (DEVICE_BATTERY_SLEEP). NOT loaded by default: pass it as the third file,
#   idf.py -DDEVICE_BATTERY_SLEEP=1 -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.sleep" ...
# like sdkconfig.defaults.ble. Plan: workbench briefs/research/2026-10-29-battery-sleep-plan.md section 3.2. Every name below was
# checked against the IDF 5.5.6 Kconfig files (test/test_sleep_overlay.py does it again when IDF_PATH is set).
#
# What it costs with the flag on, in every mode including USB (the plan's estimate; measure with `idf.py size`): about 4-6.5 KB of
# internal RAM for the power-management code and its locks. In battery mode, light sleep adds about 13.4 KB of CPU and cache-tag
# retention RAM, allocated once when the dial goes on battery and freed when external power returns (power_sleep.c).
# CONFIG_FREERTOS_HZ stays 1000 (sdkconfig.defaults): with tickless idle the tick stops while the chip sleeps, so it costs nothing there.

# Power management with automatic light sleep when every task is blocked and no lock forbids it. power_sleep.c holds a
# no-light-sleep lock in the external-power state and never calls esp_pm_configure there, so USB mode keeps its clocks.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# The chip must not sleep while a USB host is sending frames (light sleep stops the port; the host may not re-enumerate).
# A second guard beside the policy's own external-power check; see the plan section 2.3.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Light-sleep entry and exit code in internal RAM: about 2.1 KB, and a wake overhead of 0.4 ms instead of 8.6 ms (IDF constants,
# esp_hw_support/sleep_modes.c). Bench A/B decides whether it stays (plan section 5.3).
CONFIG_PM_SLP_IRAM_OPT=y

# The exit callback of auto light sleep reports how long the chip really slept; power_sleep.c adds it up for the alive line
# (pm=, slp=, slp_ms=). The callback runs from the idle task and only adds two numbers.
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y

# Skip the PSRAM boot memory test (about 2 s of every boot on 8 MB). User decision 2026-10-29 for the sleep image.
CONFIG_SPIRAM_MEMTEST=n

# Left at their defaults on purpose: PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y and PM_RESTORE_CACHE_TAGMEM_AFTER_LIGHT_SLEEP=y (retention
# RAM, saves about 650 uA), ESP_SLEEP_GPIO_RESET_WORKAROUND=y (output pins are isolated in sleep unless power_sleep.c keeps them),
# PM_DFS_INIT_AUTO=n (USB mode must never see frequency scaling), PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=n (experimental).
# Bench images only, add by hand: CONFIG_PM_PROFILING=y (esp_pm_dump_locks lists lock hold times).
